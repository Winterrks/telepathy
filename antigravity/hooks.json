{
  "telepathy": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./dist/hook.mjs --agent antigravity session-start",
        "timeout": 15
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./dist/hook.mjs --agent antigravity inbox PreInvocation",
        "timeout": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./dist/hook.mjs --agent antigravity turn-end",
        "timeout": 15
      }
    ]
  }
}
