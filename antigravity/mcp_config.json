{
  "mcpServers": {
    "telepathy": {
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/dist/server.mjs",
        "--agent",
        "antigravity"
      ],
      "env": {
        "PLUGIN_ROOT": "${PLUGIN_ROOT}",
        "TELEPATHY_HOME": "${TELEPATHY_HOME}",
        "TELEPATHY_AUTO_UPDATE": "${TELEPATHY_AUTO_UPDATE}",
        "TELEPATHY_NAME": "${TELEPATHY_NAME}",
        "TELEPATHY_DEBUG": "${TELEPATHY_DEBUG}",
        "TELEPATHY_CODEX_BIN": "${TELEPATHY_CODEX_BIN}",
        "TELEPATHY_LATEST_VERSION": "${TELEPATHY_LATEST_VERSION}",
        "TELEPATHY_VERSION_URL": "${TELEPATHY_VERSION_URL}",
        "TELEPATHY_CONFIRM_WAIT": "${TELEPATHY_CONFIRM_WAIT}",
        "TELEPATHY_CONFIRM_ABORT_MS": "${TELEPATHY_CONFIRM_ABORT_MS}",
        "TELEPATHY_CONFIRM_GRACE_MS": "${TELEPATHY_CONFIRM_GRACE_MS}",
        "TELEPATHY_CONFIRM_POLL_MS": "${TELEPATHY_CONFIRM_POLL_MS}",
        "TELEPATHY_WAKE_DEBOUNCE_MS": "${TELEPATHY_WAKE_DEBOUNCE_MS}",
        "TELEPATHY_WAKE_DEBOUNCE_MAX_MS": "${TELEPATHY_WAKE_DEBOUNCE_MAX_MS}",
        "TELEPATHY_TRANSCRIPT_DIR": "${TELEPATHY_TRANSCRIPT_DIR}",
        "TELEPATHY_HOLD_REPOST_DELAY_MS": "${TELEPATHY_HOLD_REPOST_DELAY_MS}",
        "TELEPATHY_MANAGED_SETTINGS_DIR": "${TELEPATHY_MANAGED_SETTINGS_DIR}",
        "TELEPATHY_SOCKET_WAIT_MS": "${TELEPATHY_SOCKET_WAIT_MS}",
        "TELEPATHY_AUTO_UPDATE_ENTRY": "${TELEPATHY_AUTO_UPDATE_ENTRY}",
        "TELEPATHY_CODEX_PROCS": "${TELEPATHY_CODEX_PROCS}",
        "TELEPATHY_PS_BIN": "${TELEPATHY_PS_BIN}",
        "CODEX_HOME": "${CODEX_HOME}"
      }
    }
  }
}
