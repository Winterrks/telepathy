{
  "description": "telepathy: register this Claude Code session, note when it reads, searches or edits files another agent session is editing, show other agents' sessions in ListAgents, deliver SendMessage calls addressed to them, and hand over messages at the next prompt or turn end in sessions without the plugin monitor (the Claude app, claude -p).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs\" --agent claude session-start"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs\" --agent claude files",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "ListAgents",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs\" --agent claude list-agents"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs\" --agent claude send-message",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs\" --agent claude inbox UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs\" --agent claude turn-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
