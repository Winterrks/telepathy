{
  "description": "telepathy: register this Claude Code session, show Codex sessions in ListAgents, and deliver SendMessage calls addressed to Codex.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs", "--agent", "claude", "session-start"] }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ListAgents",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs", "--agent", "claude", "list-agents"] }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "SendMessage",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs", "--agent", "claude", "send-message"], "timeout": 60 }
        ]
      }
    ]
  }
}
