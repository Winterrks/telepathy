{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node ./dist/hook.mjs --agent cursor session-start",
        "timeout": 15
      }
    ],
    "postToolUse": [
      {
        "command": "node ./dist/hook.mjs --agent cursor inbox postToolUse",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "node ./dist/hook.mjs --agent cursor turn-end",
        "timeout": 10,
        "loop_limit": 10
      }
    ]
  }
}
