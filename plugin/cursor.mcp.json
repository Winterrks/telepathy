{
  "mcpServers": {
    "telepathy": {
      "command": "node",
      "args": [
        "${CURSOR_PLUGIN_ROOT}/dist/server.mjs",
        "--agent",
        "cursor"
      ],
      "env": {
        "TELEPATHY_HOME": "${env:TELEPATHY_HOME}",
        "TELEPATHY_AUTO_UPDATE": "${env:TELEPATHY_AUTO_UPDATE}",
        "TELEPATHY_NAME": "${env:TELEPATHY_NAME}",
        "TELEPATHY_DEBUG": "${env:TELEPATHY_DEBUG}",
        "TELEPATHY_CODEX_BIN": "${env:TELEPATHY_CODEX_BIN}",
        "TELEPATHY_LATEST_VERSION": "${env:TELEPATHY_LATEST_VERSION}",
        "TELEPATHY_VERSION_URL": "${env:TELEPATHY_VERSION_URL}",
        "TELEPATHY_CONFIRM_WAIT": "${env:TELEPATHY_CONFIRM_WAIT}",
        "TELEPATHY_CONFIRM_ABORT_MS": "${env:TELEPATHY_CONFIRM_ABORT_MS}",
        "TELEPATHY_CONFIRM_GRACE_MS": "${env:TELEPATHY_CONFIRM_GRACE_MS}",
        "TELEPATHY_CONFIRM_POLL_MS": "${env:TELEPATHY_CONFIRM_POLL_MS}",
        "TELEPATHY_WAKE_DEBOUNCE_MS": "${env:TELEPATHY_WAKE_DEBOUNCE_MS}",
        "TELEPATHY_WAKE_DEBOUNCE_MAX_MS": "${env:TELEPATHY_WAKE_DEBOUNCE_MAX_MS}",
        "TELEPATHY_TRANSCRIPT_DIR": "${env:TELEPATHY_TRANSCRIPT_DIR}",
        "TELEPATHY_HOLD_REPOST_DELAY_MS": "${env:TELEPATHY_HOLD_REPOST_DELAY_MS}",
        "TELEPATHY_MANAGED_SETTINGS_DIR": "${env:TELEPATHY_MANAGED_SETTINGS_DIR}",
        "TELEPATHY_SOCKET_WAIT_MS": "${env:TELEPATHY_SOCKET_WAIT_MS}",
        "TELEPATHY_AUTO_UPDATE_ENTRY": "${env:TELEPATHY_AUTO_UPDATE_ENTRY}",
        "TELEPATHY_CODEX_PROCS": "${env:TELEPATHY_CODEX_PROCS}",
        "TELEPATHY_PS_BIN": "${env:TELEPATHY_PS_BIN}",
        "CODEX_HOME": "${env:CODEX_HOME}"
      }
    }
  }
}
