{
  "mcpServers": {
    "telepathy": {
      "command": "node",
      "args": [
        "${GROK_PLUGIN_ROOT}/dist/server.mjs",
        "--agent",
        "grok"
      ],
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 6000,
