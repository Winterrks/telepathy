{
  "name": "telepathy",
  "version": "0.8.0",
  "description": "Telepathy for your coding agents: Claude Code, Codex, OpenCode, Gemini CLI, Copilot CLI, Cursor, Grok, Devin, Antigravity, Kimi Code, Qwen Code and Kilo Code sessions on one machine message each other.",
  "private": true,
  "type": "module",
  "main": "plugin/dist/opencode.mjs",
  "exports": {
    ".": "./plugin/dist/opencode.mjs",
    "./server": "./plugin/dist/opencode.mjs"
  },
  "license": "MIT",
  "homepage": "https://github.com/Winterrks/telepathy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Winterrks/telepathy.git"
  },
  "bugs": {
    "url": "https://github.com/Winterrks/telepathy/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "gemini-cli",
    "copilot-cli",
    "cursor",
    "grok",
    "devin",
    "antigravity",
    "kimi-code",
    "qwen-code",
    "kilo-code",
    "mcp",
    "plugin",
    "multi-agent",
    "agent-communication"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bundle": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run bundle && npm test"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "zod": "^4.2.0"
  }
}
